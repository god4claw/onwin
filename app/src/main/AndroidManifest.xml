<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Обработка записей в foreground-сервисе: dataSync до API 34, mediaProcessing с API 35. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- CPU не засыпает при выключенном экране, пока идёт задание. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!--
        ONNX Runtime GenAI объявляет сеть и ContentProvider телеметрии. Приложение
        полностью офлайн, поэтому и разрешения, и провайдер вырезаются из манифеста:
        без этого сборка «с LLM» перестала бы быть сборкой без INTERNET.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:name=".OnWinApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OnWin">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OnWin"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ui.notification.ProcessingService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing|microphone" />

        <!-- Позволяет собирать точные трейсы на Release без замедления -->
        <profileable android:shell="true" />

        <!--
            Оба AAR — onnxruntime-genai и onnxruntime — объявляют ContentProvider
            телеметрии: он грузит libmat и инициализирует 1DS-клиент с сетью.
            Приложению это не нужно и противоречит офлайну.
        -->
        <provider
            android:name="ai.onnxruntime.genai.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_genai_telemetry_initializer"
            tools:node="remove" />
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove" />
    </application>

</manifest>
